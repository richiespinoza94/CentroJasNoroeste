# Firebase console → Project settings → General → Your apps → SDK setup and
# configuration → "Config". These values are NOT secret (they're meant to be
# embedded in the client bundle); what actually protects the data is
# firestore.rules, not hiding this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=centro-jas-noroeste.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=centro-jas-noroeste
VITE_FIREBASE_STORAGE_BUCKET=centro-jas-noroeste.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only used by scripts/seed-firestore.mjs (Node, never shipped to the
# browser). Path to a service account key JSON downloaded from Firebase
# console → Project settings → Service accounts → Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PIN=1234
