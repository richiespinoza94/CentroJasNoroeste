diff --git a/firestore.rules b/firestore.rules
index 2e96ed2..2d243ce 100644
--- a/firestore.rules
+++ b/firestore.rules
@@ -32,9 +32,6 @@ service cloud.firestore {
     function isSelf(uid) {
       return isSignedIn() && request.auth.uid == uid;
     }
-    function onlyAffects(fields) {
-      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
-    }
 
     // Deprecated as of Fase 2 (personas/inscripciones) — kept read-only for
     // staff as a historical backup of pre-migration data. The app no longer
@@ -97,16 +94,24 @@ service cloud.firestore {
       allow write: if isAdmin();
     }
 
-    // Tables: staff can read and can move people in/out (which only ever
-    // touches `occ`, always inside a transaction — see collections.js).
-    // Everything else (capacity, reservedFor, creating/deleting a table) is
-    // an admin-only operation (PRD §4).
-    match /tables/{tableId} {
-      allow read: if isStaff();
-      allow create, delete: if isAdmin();
-      allow update: if isAdmin() || (isStaff() && onlyAffects(['occ']));
+    // Índice público mínimo (Fase 2 — identidad única en el formulario): ID
+    // aleatorio a propósito, nunca el whatsapp — ver nota en collections.js.
+    // Solo nombre completo + estaca, jamás datos de contacto.
+    match /personas_publico/{docId} {
+      function isValidPublicIndexWrite() {
+        let d = request.resource.data;
+        return d.nombreCompleto is string && d.nombreCompleto.size() > 0 && d.nombreCompleto.size() <= 90
+          && d.estaca is string && d.estaca.size() <= 40
+          && d.keys().hasOnly(['nombreCompleto', 'estaca']);
+      }
+      allow read: if true;
+      allow create: if isValidPublicIndexWrite();
+      allow update, delete: if false;
     }
 
+    // Tables (mesas) se sacó del núcleo — ver README/patch de referencia si
+    // se necesita reactivar para un evento tipo cena.
+
     // A username+role an admin reserved, before that person has ever signed
     // in. Publicly readable so the login screen can tell "not registered"
     // apart from "registered, needs to set a PIN" without an admin session.
diff --git a/scripts/seed-firestore.mjs b/scripts/seed-firestore.mjs
index cf40515..8025a1f 100644
--- a/scripts/seed-firestore.mjs
+++ b/scripts/seed-firestore.mjs
@@ -7,7 +7,6 @@
 import { initializeApp, applicationDefault } from 'firebase-admin/app';
 import { getFirestore, FieldValue } from 'firebase-admin/firestore';
 import { getAuth } from 'firebase-admin/auth';
-import { DEFAULT_TABLES } from '../src/domain/constants.js';
 
 // Keep these two in sync with src/firebase/auth.js — duplicated on purpose,
 // the Admin SDK and the client SDK can't share a module cleanly, and it's
@@ -20,18 +19,6 @@ initializeApp({ credential: applicationDefault() });
 const db = getFirestore();
 const auth = getAuth();
 
-async function seedTables() {
-  let created = 0;
-  for (const t of DEFAULT_TABLES) {
-    const ref = db.collection('tables').doc(String(t.id));
-    const snap = await ref.get();
-    if (snap.exists) continue; // never clobber an admin's edits on re-run
-    await ref.set({ name: t.name, capacity: t.capacity, reservedFor: t.reservedFor, occ: 0, createdAt: FieldValue.serverTimestamp() });
-    created++;
-  }
-  console.log(`tables: ${created} created, ${DEFAULT_TABLES.length - created} already existed.`);
-}
-
 async function seedBootstrapAdmin() {
   const username = (process.env.SEED_ADMIN_USERNAME || 'admin').trim().toLowerCase();
   const pin = process.env.SEED_ADMIN_PIN || '1234';
@@ -52,6 +39,5 @@ async function seedBootstrapAdmin() {
   console.log(`admin bootstrap: created "${username}" (PIN ${pin}) — change this PIN after first login.`);
 }
 
-await seedTables();
 await seedBootstrapAdmin();
 console.log('\nDone.');
diff --git a/scripts/self-check.mjs b/scripts/self-check.mjs
index f738ee2..24c50e0 100644
--- a/scripts/self-check.mjs
+++ b/scripts/self-check.mjs
@@ -1,8 +1,7 @@
-// ponytail: one runnable check for the branchy domain logic (validation +
-// table recommendation), not a full test suite. `npm run check` runs this.
+// ponytail: one runnable check for the branchy domain logic (validation),
+// not a full test suite. `npm run check` runs this.
 import assert from 'node:assert/strict';
 import { validateRegistration, validateManual, ageFromDate } from '../src/domain/validation.js';
-import { recommendTables } from '../src/domain/tables.js';
 
 let passed = 0;
 function check(name, fn) {
@@ -88,40 +87,4 @@ check('validateManual requires whatsapp + estaca/barrio, no duplicates', () => {
   );
 });
 
-// occ is a denormalized counter Firestore keeps in sync inside the
-// assign/unassign transaction (see src/firebase/collections.js) — these
-// fixtures stand in for that field directly, no participants array needed.
-const tables = [
-  { id: 1, name: 'Mesa 1', capacity: 10, reservedFor: null, occ: 0 },
-  { id: 2, name: 'Mesa 2', capacity: 10, reservedFor: null, occ: 0 },
-  { id: 9, name: 'Mesa Líderes', capacity: 8, reservedFor: 'Líder', occ: 0 },
-];
-
-check('recommendTables excludes reserved tables for the wrong category', () => {
-  const staffPerson = { categoria: 'Staff' };
-  const recs = recommendTables(staffPerson, tables);
-  assert.ok(!recs.some((r) => r.id === 9), 'staff should not be recommended the líderes table');
-});
-
-check('recommendTables includes the reserved table for its own category', () => {
-  const liderPerson = { categoria: 'Líder' };
-  const recs = recommendTables(liderPerson, tables);
-  assert.ok(recs.some((r) => r.id === 9));
-});
-
-check('recommendTables sorts tightest-fit first to avoid fragmentation', () => {
-  const partial = [
-    { id: 1, name: 'Mesa 1', capacity: 10, reservedFor: null, occ: 8 }, // 2 left
-    { id: 2, name: 'Mesa 2', capacity: 10, reservedFor: null, occ: 0 }, // 10 left
-  ];
-  const recs = recommendTables({ categoria: 'Miembro' }, partial);
-  assert.equal(recs[0].id, 1, 'tightest fit (2 left) should come before an empty table (10 left)');
-});
-
-check('recommendTables excludes full tables and caps at 3 results', () => {
-  const manyTables = Array.from({ length: 5 }, (_, i) => ({ id: 100 + i, name: `T${i}`, capacity: 10, reservedFor: null, occ: 0 }));
-  const recs = recommendTables({ categoria: 'Miembro' }, manyTables);
-  assert.equal(recs.length, 3);
-});
-
 console.log(`\n${passed} checks passed.`);
