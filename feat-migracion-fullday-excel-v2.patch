diff --git a/scripts/migrate-fullday-xlsx.mjs b/scripts/migrate-fullday-xlsx.mjs
new file mode 100644
index 0000000..85021ff
--- /dev/null
+++ b/scripts/migrate-fullday-xlsx.mjs
@@ -0,0 +1,195 @@
+// One-time migration. Run with:
+//   node --env-file=.env.local scripts/migrate-fullday-xlsx.mjs <ruta-al-excel.xlsx> <activityId>
+// Needs GOOGLE_APPLICATION_CREDENTIALS pointing at a service account key
+// (same setup as seed-firestore.mjs / migrate-personas-fase2.mjs). Uses the
+// Admin SDK, which bypasses firestore.rules.
+//
+// Reads the Full Day preinscripción export (same columns the Google Apps
+// Script backend wrote to Sheets) and creates/updates:
+//   - personas/{whatsapp}        — identity data, shared across activities
+//   - inscripciones/{activityId}_{whatsapp} — this person's registration
+//     for the Full Day activity you point it at
+//
+// Unifica por WhatsApp, on purpose (ponytail — misma idea que Fase 2, no
+// una idea nueva):
+//   - Si el WhatsApp YA existe en `personas` (p.ej. alguien que también
+//     está en La Velada), NO se sobrescriben sus datos actuales — solo se
+//     rellenan los campos que estén vacíos. Los datos de este Excel son de
+//     junio; si la persona ya tiene datos más recientes en el sistema
+//     (agosto), esos datos más recientes ganan.
+//   - Si el WhatsApp NO existe, se crea la persona de cero con los datos
+//     del Excel.
+//   - La inscripción a esta actividad se crea siempre que no exista ya
+//     (si ya existe — por ejemplo alguien la creó a mano en la app — se
+//     deja intacta, para no pisar un ajuste manual).
+//
+// Fuera de alcance a propósito: "Grupo asignado", "Es líder", "Vinculado
+// con", etc. — esa es la lógica de agrupación tipo mesas que se sacó del
+// núcleo de la app; esos datos existen en el Excel pero no se migran.
+// "Alergia alimentaria" y "Sugerencia de actividad" sí se guardan, como
+// campos extra en la inscripción (información específica de esa actividad,
+// no de la identidad de la persona).
+//
+// No destructivo y seguro de volver a correr.
+import { initializeApp, applicationDefault } from 'firebase-admin/app';
+import { getFirestore, FieldValue } from 'firebase-admin/firestore';
+import XLSX from 'xlsx';
+
+initializeApp({ credential: applicationDefault() });
+const db = getFirestore();
+
+const xlsxPath = process.argv[2];
+const activityId = process.argv[3];
+
+async function listActivities() {
+  const snap = await db.collection('activities').get();
+  console.log('\nActividades disponibles (usa el ID exacto, no el nombre):');
+  snap.forEach((d) => console.log(`  ${d.id}  —  ${d.data().nombre} (${d.data().fecha})`));
+}
+
+// Convierte un serial de fecha de Excel a "YYYY-MM-DD" operando en UTC de
+// principio a fin — la alternativa obvia (pasar por un objeto Date local)
+// desplaza la fecha un día para cualquiera con hora de registro después de
+// medianoche en su zona horaria, que es exactamente lo que se ve en este
+// archivo (fechas de nacimiento con hora "19:00:00" pegada).
+function excelSerialToISODate(serial) {
+  if (serial === '' || serial == null) return '';
+  const days = Math.floor(Number(serial)); // solo la fecha, se descarta la fracción de hora
+  if (Number.isNaN(days)) return '';
+  const utcMillis = (days - 25569) * 86400 * 1000;
+  const d = new Date(utcMillis);
+  const y = d.getUTCFullYear();
+  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${y}-${m}-${day}`;
+}
+
+function excelSerialToDate(serial) {
+  if (serial === '' || serial == null) return null;
+  const millis = (Number(serial) - 25569) * 86400 * 1000;
+  return Number.isNaN(millis) ? null : new Date(millis);
+}
+
+const ESTADO_TO_STATUS = { Asistió: 'presente', Pendiente: 'pendiente' };
+const cap = (s) => (s || '').toString().trim();
+
+async function migrate() {
+  if (!xlsxPath || !activityId) {
+    console.error('Uso: node --env-file=.env.local scripts/migrate-fullday-xlsx.mjs <ruta-al-excel.xlsx> <activityId>');
+    await listActivities();
+    process.exit(1);
+  }
+
+  const activitySnap = await db.collection('activities').doc(activityId).get();
+  if (!activitySnap.exists) {
+    console.error(`No existe una actividad con ID "${activityId}".`);
+    await listActivities();
+    process.exit(1);
+  }
+  console.log(`Migrando hacia la actividad: "${activitySnap.data().nombre}" (${activitySnap.data().fecha})`);
+
+  const wb = XLSX.readFile(xlsxPath);
+  const sheet = wb.Sheets[wb.SheetNames[0]];
+  const rows = XLSX.utils.sheet_to_json(sheet, { raw: true, defval: '' });
+  console.log(`${rows.length} filas encontradas en el Excel.\n`);
+
+  let personasCreadas = 0;
+  let personasCompletadas = 0; // ya existía, se le rellenaron campos vacíos
+  let personasSinCambios = 0; // ya existía y ya tenía todo — no hizo falta tocarla
+  let inscripcionesCreadas = 0;
+  let inscripcionesYaExistian = 0;
+  const invalidos = [];
+
+  const batchSize = 400;
+  let batch = db.batch();
+  let opsInBatch = 0;
+  async function commitIfFull() {
+    if (opsInBatch >= batchSize) {
+      await batch.commit();
+      batch = db.batch();
+      opsInBatch = 0;
+    }
+  }
+
+  for (const row of rows) {
+    const whatsapp = cap(row['WhatsApp']).replace(/\s/g, '');
+    if (!/^9\d{8}$/.test(whatsapp)) {
+      invalidos.push({ nombre: cap(row['Nombre completo']), whatsapp });
+      continue;
+    }
+
+    const personaRef = db.collection('personas').doc(whatsapp);
+    const personaSnap = await personaRef.get();
+    const existing = personaSnap.exists ? personaSnap.data() : null;
+
+    const excelData = {
+      nombre: cap(row['Nombre']),
+      apellidos: cap(row['Apellidos']),
+      sexo: cap(row['Sexo']),
+      fechaNacimiento: excelSerialToISODate(row['Fecha de nacimiento']),
+      estaca: cap(row['Estaca']),
+      barrio: cap(row['Barrio / Rama']),
+      correo: cap(row['Correo']),
+    };
+
+    if (!existing) {
+      batch.set(personaRef, { ...excelData, createdAt: FieldValue.serverTimestamp(), updatedAt: FieldValue.serverTimestamp() });
+      opsInBatch++;
+      personasCreadas++;
+    } else {
+      // Solo se rellenan los campos que hoy están vacíos — un dato más
+      // reciente ya en el sistema (p.ej. de La Velada, en agosto) nunca se
+      // pisa con este Excel, que es de junio.
+      const fill = {};
+      for (const [key, val] of Object.entries(excelData)) {
+        if (val && !existing[key]) fill[key] = val;
+      }
+      if (Object.keys(fill).length > 0) {
+        batch.update(personaRef, { ...fill, updatedAt: FieldValue.serverTimestamp() });
+        opsInBatch++;
+        personasCompletadas++;
+      } else {
+        personasSinCambios++;
+      }
+    }
+
+    const inscripcionRef = db.collection('inscripciones').doc(`${activityId}_${whatsapp}`);
+    const inscripcionSnap = await inscripcionRef.get();
+    if (inscripcionSnap.exists) {
+      inscripcionesYaExistian++;
+    } else {
+      const alergia = cap(row['Alergia alimentaria']);
+      const sugerencia = cap(row['Sugerencia de actividad']);
+      const fechaRegistro = excelSerialToDate(row['Fecha registro']);
+      batch.set(inscripcionRef, {
+        activityId,
+        whatsapp,
+        categoria: cap(row['Tipo participante']) || 'Miembro',
+        status: ESTADO_TO_STATUS[cap(row['Estado'])] || 'pendiente',
+        ...(alergia ? { alergia } : {}),
+        ...(sugerencia ? { sugerencia } : {}),
+        createdAt: fechaRegistro || FieldValue.serverTimestamp(),
+        updatedAt: FieldValue.serverTimestamp(),
+      });
+      opsInBatch++;
+      inscripcionesCreadas++;
+    }
+
+    await commitIfFull();
+  }
+  if (opsInBatch > 0) await batch.commit();
+
+  console.log('Listo.');
+  console.log(`  Personas nuevas creadas:            ${personasCreadas}`);
+  console.log(`  Personas ya existentes, completadas: ${personasCompletadas}  (se les rellenó algún campo vacío)`);
+  console.log(`  Personas ya existentes, sin cambios: ${personasSinCambios}  (ya tenían todo)`);
+  console.log(`  Inscripciones creadas:               ${inscripcionesCreadas}`);
+  console.log(`  Inscripciones que ya existían:        ${inscripcionesYaExistian}  (se dejaron intactas)`);
+  if (invalidos.length) {
+    console.log(`\n⚠ ${invalidos.length} fila(s) con WhatsApp inválido — no se migraron:`);
+    invalidos.forEach((i) => console.log(`  ${i.nombre}: "${i.whatsapp}"`));
+  }
+  console.log('\nNo migrado a propósito (grupos/mesas, ver comentario al inicio del script): "Grupo asignado", "Es líder", "Vinculado con".');
+}
+
+await migrate();
