rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
//
// Design notes (see README for the full writeup):
// - No PIN ever touches Firestore. The 4-digit staff PIN is folded into a
//   Firebase Auth email/password pair (see src/firebase/auth.js); Firebase's
//   own servers verify it, these rules never see it.
// - `pendingStaff/{username}` is where an admin reserves a username+role
//   *before* that person has ever signed in. `staff/{uid}` is the real
//   profile, created by the person themselves on first login, but the role
//   they can claim is locked to whatever the admin reserved — a client can
//   never self-assign role:'admin'.
// - `participants/{whatsapp}` uses the WhatsApp number as the document ID so
//   "no duplicate registrations" is an atomic doc-creation check, not a
//   racy query.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isAdmin() {
      return isStaff() && staffDoc().role == 'admin';
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Deprecated as of Fase 2 (personas/inscripciones) — kept read-only for
    // staff as a historical backup of pre-migration data. The app no longer
    // reads or writes this collection; see scripts/migrate-personas-fase2.mjs.
    match /participants/{whatsapp} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Fase 2 — identidad única: one persona per WhatsApp number, shared
    // across every activity. Doc ID = whatsapp, same "atomic doc-creation
    // instead of a racy query" trick as the old participants collection.
    // Public create/update is allowed (self-registration writes their own
    // identity data — a phone number belongs to one persona regardless of
    // which activity they're registering for), but only with an identity
    // shape — status/categoria/tableId live in inscripciones, never here.
    match /personas/{whatsapp} {
      function isValidPersonaWrite() {
        let d = request.resource.data;
        return whatsapp.matches('^9[0-9]{8}$')
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
          && d.apellidos is string && d.apellidos.size() > 0 && d.apellidos.size() <= 50;
      }
      // Exact-ID lookup stays public (dedup check by phone before submit).
      // Full enumeration — needed for Admin → Personas and for name-based
      // dedup search — is staff-only for now (see Fase 2 notes).
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if isValidPersonaWrite() || isStaff();
      allow delete: if false;
    }

    // One inscripción per persona per actividad. Doc ID =
    // `${activityId}_${whatsapp}`, so "already registered for this
    // activity" is an atomic doc-creation check — but the SAME persona can
    // hold a separate inscripción doc for a different activity.
    match /inscripciones/{inscripcionId} {
      function isValidPublicInscripcionCreate() {
        let d = request.resource.data;
        return inscripcionId == (d.activityId + '_' + d.whatsapp)
          && d.whatsapp.matches('^9[0-9]{8}$')
          && d.status == 'presente'
          && d.get('tableId', null) == null
          && d.categoria in ['Miembro', 'Invitado'];
      }
      allow get: if true;
      allow list: if isStaff();
      allow create: if isValidPublicInscripcionCreate() || isStaff();
      allow update: if isStaff();
      allow delete: if false;
    }

    // Activities (PRD generalización, Fase 1): the app is no longer scoped
    // to one hardcoded event — staff creates/edits activities here and
    // marks one "activa". Publicly readable (the registration form and the
    // navbar need the active activity's name/date before anyone logs in),
    // writable only by admins.
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Índice público (Fase 2 — identidad única en el formulario): ID =
    // whatsapp, a propósito — es lo que permite que al confirmar "¿eres
    // tú?" el formulario pueda enlazar directamente con esa persona en vez
    // de crear una nueva (decisión tomada con el cliente: costo/beneficio
    // favorece esto sobre mantener un backend aparte solo para ocultarlo).
    // Solo nombre completo + estaca — nunca correo, fecha de nacimiento o
    // barrio.
    match /personas_publico/{whatsapp} {
      function isValidPublicIndexWrite() {
        let d = request.resource.data;
        return whatsapp.matches('^9[0-9]{8}$')
          && d.nombreCompleto is string && d.nombreCompleto.size() > 0 && d.nombreCompleto.size() <= 90
          && d.estaca is string && d.estaca.size() <= 40
          && d.keys().hasOnly(['nombreCompleto', 'estaca']);
      }
      allow read: if true;
      allow create, update: if isValidPublicIndexWrite();
      allow delete: if false;
    }

    // Tables (mesas) se sacó del núcleo — ver README/patch de referencia si
    // se necesita reactivar para un evento tipo cena.

    // A username+role an admin reserved, before that person has ever signed
    // in. Publicly readable so the login screen can tell "not registered"
    // apart from "registered, needs to set a PIN" without an admin session.
    match /pendingStaff/{username} {
      allow read: if true;
      allow create: if isAdmin();
      // An admin can always retract a reservation. Once claimed, the person
      // who just created their own staff profile can clear their own
      // leftover reservation doc too (never anyone else's).
      allow delete: if isAdmin() || (isStaff() && staffDoc().username == username);
      allow update: if false;
    }

    // Reverse pointer so the login screen can tell "needs to create a PIN"
    // apart from "already has one" without reading the staff profile itself.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSelf(request.resource.data.uid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // The real staff profile. Role is locked to whatever the admin put in
    // pendingStaff/{username} at creation time — a signed-in user can never
    // hand themselves a different role than the one an admin reserved.
    match /staff/{uid} {
      function pendingRole() {
        return get(/databases/$(database)/documents/pendingStaff/$(request.resource.data.username)).data.role;
      }
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.role == pendingRole()
        && request.resource.data.username is string;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
